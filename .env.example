# Optional public origin. Phase 0 runs without an .env.local file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for authentication. Leave both blank for safe unavailable-account mode.
# Use a development project's URL and publishable key. Local CLI anon keys also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place elevated Supabase keys in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_SITE_URL must match the trusted origin used in Auth email links.
# No service-role or secret key is needed by the application in this phase.
